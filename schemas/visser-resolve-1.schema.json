{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visser.invalid/schemas/visser-resolve-1.schema.json",
  "title": "Visser resolver result (visser-resolve/1, \u00a711.6)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "visser-resolve/1"
    },
    "status": {
      "enum": [
        "exact",
        "stale",
        "deleted",
        "ambiguous",
        "missing",
        "invalid"
      ]
    },
    "docId": {
      "type": "string"
    },
    "targetId": {
      "type": "string"
    },
    "viewedRevision": {
      "$ref": "#/$defs/sha256"
    },
    "currentRevision": {
      "$ref": "#/$defs/sha256"
    },
    "targetBodyUnchanged": {
      "type": "boolean"
    },
    "quoteFound": {
      "type": "boolean"
    },
    "labelMatches": {
      "type": "boolean"
    },
    "kindMatches": {
      "type": "boolean"
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "sourceText",
        "parentContext",
        "dependencies"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/targetRecord"
        },
        "sourceText": {
          "type": "string"
        },
        "parentContext": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[EW]_[A-Z_]+$"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "targetId": {
          "type": "string"
        },
        "suggestedAction": {
          "type": "string"
        }
      }
    },
    "targetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "targetRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "span",
        "bodySha256",
        "dependencies",
        "plainText",
        "inspectable"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/targetId"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "parentId": {
          "$ref": "#/$defs/targetId"
        },
        "sectionId": {
          "$ref": "#/$defs/targetId"
        },
        "ownerComponentId": {
          "$ref": "#/$defs/targetId"
        },
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "startByte",
            "endByte",
            "startLine",
            "endLine",
            "fileSha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "startByte": {
              "type": "integer",
              "minimum": 0
            },
            "endByte": {
              "type": "integer",
              "minimum": 0
            },
            "startLine": {
              "type": "integer",
              "minimum": 1
            },
            "endLine": {
              "type": "integer",
              "minimum": 1
            },
            "fileSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "bodySha256": {
          "$ref": "#/$defs/sha256"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/targetId"
          }
        },
        "plainText": {
          "type": "string"
        },
        "inspectable": {
          "type": "boolean"
        }
      }
    }
  }
}
