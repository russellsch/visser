{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visser.invalid/schemas/visser-export-1.schema.json",
  "title": "visser export --format html|site --json: the export report (§13.5)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "format", "audience", "out", "includeSource", "documents", "sources", "mermaidPages", "assetPacks", "warnings"],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "docId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sitePath": { "type": "string", "minLength": 1, "pattern": "^[^/]" }
  },
  "properties": {
    "schema": { "const": "visser-export/1" },
    "format": { "enum": ["html", "site"] },
    "audience": { "enum": ["private", "public"] },
    "out": { "type": "string", "minLength": 1 },
    "includeSource": { "type": "boolean" },
    "allowPrivateContent": { "const": true },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "path"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/sitePath" }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["docId", "title", "visibility", "path", "sourceRevision", "buildId", "toolkitSha256", "mermaid"],
        "properties": {
          "docId": { "$ref": "#/$defs/docId" },
          "title": { "type": "string" },
          "visibility": { "enum": ["private", "public"] },
          "path": { "$ref": "#/$defs/sitePath" },
          "sourceRevision": { "$ref": "#/$defs/sha256" },
          "buildId": { "$ref": "#/$defs/sha256" },
          "toolkitSha256": { "$ref": "#/$defs/sha256" },
          "mermaid": { "type": "boolean" }
        }
      }
    },
    "sources": {
      "description": "Every source whose kind is not example or supplied, whatever the document's visibility.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["docId", "id", "kind", "publicRepository"],
        "properties": {
          "docId": { "$ref": "#/$defs/docId" },
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "publicRepository": { "type": "boolean", "description": "True only when `repository` is in the user-config publicRepositories allowlist." }
        }
      }
    },
    "mermaidPages": { "type": "array", "items": { "$ref": "#/$defs/sitePath" } },
    "assetPacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["toolkitSha256", "path", "files"],
        "properties": {
          "toolkitSha256": { "$ref": "#/$defs/sha256" },
          "path": { "$ref": "#/$defs/sitePath" },
          "files": { "type": "array", "minItems": 1, "items": { "enum": ["reader.js", "reader.css", "mermaid.js"] } }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^W_[A-Z_]+$" },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "format": { "const": "html" } }, "required": ["format"] },
      "then": {
        "properties": {
          "includeSource": { "const": false },
          "documents": { "type": "array", "maxItems": 1 },
          "assetPacks": { "type": "array", "maxItems": 0 }
        },
        "not": { "properties": { "collection": true }, "required": ["collection"] }
      },
      "else": { "properties": { "assetPacks": { "type": "array", "minItems": 1 } } }
    }
  ]
}
