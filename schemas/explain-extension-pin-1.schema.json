{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://explain.invalid/schemas/explain-extension-pin-1.schema.json",
  "title": "explain extension pin --json: the lock entry written for a document (\u00a712.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "doc",
    "name",
    "version",
    "sha256",
    "changed"
  ],
  "properties": {
    "schema": {
      "const": "explain-extension-pin/1"
    },
    "doc": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changed": {
      "type": "boolean"
    },
    "diff": {
      "type": "string"
    }
  }
}
