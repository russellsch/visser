{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visser.invalid/schemas/visser-trust-store-1.schema.json",
  "title": "The user trust store: toolkit and extension digests the user trusts to run (\u00a712.4, \u00a714.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "toolkits"
  ],
  "properties": {
    "schema": {
      "const": "visser-trust-store/1"
    },
    "toolkits": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9a-f]{64}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "addedAt"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "addedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9a-f]{64}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "addedAt"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "addedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          }
        }
      }
    }
  }
}
