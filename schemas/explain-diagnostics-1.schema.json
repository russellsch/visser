{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://explain.invalid/schemas/explain-diagnostics-1.schema.json",
  "title": "Error envelope for any --json command that fails before producing its own output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "explain-diagnostics/1"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "https://explain.invalid/schemas/explain-resolve-1.schema.json#/$defs/diagnostic"
      }
    }
  }
}
