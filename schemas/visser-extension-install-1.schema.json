{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visser.invalid/schemas/visser-extension-install-1.schema.json",
  "title": "visser extension install --json (\u00a714.2): installing never trusts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope",
    "name",
    "version",
    "sha256",
    "path",
    "alreadyInstalled",
    "trusted"
  ],
  "properties": {
    "schema": {
      "const": "visser-extension-install/1"
    },
    "scope": {
      "enum": [
        "user",
        "repo"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "alreadyInstalled": {
      "type": "boolean"
    },
    "trusted": {
      "type": "boolean"
    }
  }
}
