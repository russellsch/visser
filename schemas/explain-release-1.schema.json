{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://explain.invalid/schemas/explain-release-1.schema.json",
  "title": "release.json: the toolkit manifest whose canonical digest is the toolkit digest (\u00a712.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "explain-release/1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "minItems": 1
    }
  }
}
