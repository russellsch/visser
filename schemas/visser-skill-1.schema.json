{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visser.invalid/schemas/visser-skill-1.schema.json",
  "title": "visser skill show --json (§12.7, §17.1): the pinned core skill and local guide paths",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "toolkit", "skill", "guides"],
  "properties": {
    "schema": { "const": "visser-skill/1" },
    "toolkit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "version", "dir", "source"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "version": { "type": "string" },
        "dir": { "type": "string", "minLength": 1 },
        "source": { "enum": ["toolkit-dir", "repository", "user", "running", "dev-toolkit"] }
      }
    },
    "document": { "type": "string" },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "text"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "text": { "type": "string" }
      }
    },
    "guides": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
