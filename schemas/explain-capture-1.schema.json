{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://explain.invalid/schemas/explain-capture-1.schema.json",
  "title": "explain capture git|file --json (\u00a78.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "docId",
    "id",
    "replaced",
    "oldRevision",
    "newRevision",
    "attributes"
  ],
  "properties": {
    "schema": {
      "const": "explain-capture/1"
    },
    "docId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "replaced": {
      "type": "boolean"
    },
    "oldRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "newRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "excerptSha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "kind": {
          "enum": [
            "git",
            "working-tree",
            "web",
            "file",
            "supplied",
            "example"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "baseCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "capturedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "excerptSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "originFileSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
