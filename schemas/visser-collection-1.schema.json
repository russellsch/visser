{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visser.invalid/schemas/visser-collection-1.schema.json",
  "title": "Collection input for visser export --collection (§13.5)",
  "description": "Each document path is relative to the collection file and must stay inside the repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "title", "documents"],
  "properties": {
    "schema": { "const": "visser-collection/1" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    }
  }
}
