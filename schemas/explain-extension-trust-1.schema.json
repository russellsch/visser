{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://explain.invalid/schemas/explain-extension-trust-1.schema.json",
  "title": "explain extension trust --json (\u00a714.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "digest",
    "trusted",
    "changed"
  ],
  "properties": {
    "schema": {
      "const": "explain-extension-trust/1"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trusted": {
      "type": "boolean"
    },
    "changed": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "addedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
