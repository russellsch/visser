{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visser.invalid/schemas/visser-check-1.schema.json",
  "title": "visser check --json (\u00a717.1, \u00a78.5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "targetCount",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "visser-check/1"
    },
    "ok": {
      "type": "boolean"
    },
    "targetCount": {
      "type": "integer",
      "minimum": 0
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "https://visser.invalid/schemas/visser-resolve-1.schema.json#/$defs/diagnostic"
      }
    },
    "origins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "kind": {
            "enum": [
              "git",
              "working-tree",
              "web",
              "file",
              "supplied",
              "example"
            ]
          },
          "state": {
            "enum": [
              "origin-matched",
              "origin-mismatch",
              "origin-unavailable",
              "working-tree-matched",
              "capture-consistent",
              "link-only"
            ]
          },
          "reason": {
            "type": "string"
          },
          "checkedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
          }
        }
      }
    }
  }
}
