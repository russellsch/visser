{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://explain.invalid/schemas/explain-frontmatter.schema.json",
  "title": "Explain document frontmatter (format explain/1, §6.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "docId", "title", "kind", "capturedAt", "visibility"],
  "properties": {
    "format": { "const": "explain/1" },
    "docId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "kind": { "enum": ["architecture", "plan", "root-cause", "teaching", "decision", "reference"] },
    "capturedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "visibility": { "enum": ["private", "public"] },
    "reader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "knows": { "$ref": "#/$defs/stringList" },
        "new": { "$ref": "#/$defs/stringList" },
        "mustUnderstand": { "$ref": "#/$defs/stringList" },
        "questions": { "$ref": "#/$defs/stringList" }
      }
    },
    "retiredTargets": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": {
          "reason": { "type": "string", "minLength": 1 },
          "replacement": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }
        }
      }
    }
  },
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
