{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visser.invalid/schemas/visser-extension-inspect-1.schema.json",
  "title": "visser extension inspect --json (\u00a714.3): static metadata; nothing is executed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "sha256",
    "path",
    "trusted",
    "executable",
    "buildEntry",
    "files",
    "componentSchema",
    "guide"
  ],
  "properties": {
    "schema": {
      "const": "visser-extension-inspect/1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "location": {
      "enum": [
        "repository",
        "user",
        "directory"
      ]
    },
    "trusted": {
      "type": "boolean"
    },
    "executable": {
      "const": true
    },
    "buildEntry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "componentSchema": {
      "type": "object"
    },
    "guide": {
      "type": "string",
      "maxLength": 65536
    }
  }
}
