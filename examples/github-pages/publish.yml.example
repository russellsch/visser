# Example GitHub Pages publication for a Visser export (ARCHITECTURE.md §13.5).
#
# Disabled by default, in two ways:
#   1. The file name ends in `.example`, so GitHub does not run it. To enable
#      it, copy it to .github/workflows/publish.yml in your own repository.
#   2. It runs only when a person starts it (workflow_dispatch); a push never
#      publishes anything.
#
# It publishes a folder that you exported, reviewed, and committed yourself:
#
#   visser export --collection docs/explanations/collection.json \
#     --format site --audience public --out site
#
# It does not build documents, install the toolkit, or read any secret.
#
# Every action is pinned to a full commit SHA. On 27 September 2026 each SHA
# was checked with `git ls-remote` against the release tag in its comment.
name: Publish Visser site

on:
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-24.04
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Check out the repository
        # pin: verified 2026-09-27 (actions/checkout v4.2.2)
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          persist-credentials: false
      - name: Configure GitHub Pages
        # pin: verified 2026-09-27 (actions/configure-pages v5.0.0)
        uses: actions/configure-pages@983d7736d9b0ae728b81ab479565c72886d7745b
      - name: Upload the exported site
        # pin: verified 2026-09-27 (actions/upload-pages-artifact v3.0.1)
        uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa
        with:
          path: site
      - name: Deploy to GitHub Pages
        id: deployment
        # pin: verified 2026-09-27 (actions/deploy-pages v4.0.5)
        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e
