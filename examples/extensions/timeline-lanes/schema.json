{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "timeline-lanes component input",
  "type": "object",
  "required": ["component", "parts"],
  "properties": {
    "component": {
      "type": "object",
      "required": ["attributes"],
      "properties": {
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "unit": { "type": "string", "maxLength": 16 } }
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["attributes"],
        "properties": {
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "number" },
              "end": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
