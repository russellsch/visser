{
  "name": "visser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/runtime",
    "packages/cli"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run",
    "test:contracts": "node scripts/check-contracts.mjs",
    "test:browser": "playwright test",
    "test:clean-machine": "node scripts/clean-machine.mjs",
    "test:offline": "node scripts/check-offline.mjs",
    "test:budgets": "node scripts/check-budgets.mjs",
    "release:pack": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  }
}
